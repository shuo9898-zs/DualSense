<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <vType id="car" vClass="passenger" accel="2.9" decel="5.0" sigma="0.3" length="4.5" minGap="2.0" maxSpeed="55.0" color="1,1,0"/>
    
    <!-- Route从edge 7开始 -->
    <route id="route_from_7" edges="7 6 5 4 -8 -1 -2 -3 -0 -10 -17 7"/>
    
    <!-- Route从edge 5开始 -->
    <route id="route_from_5" edges="5 4 -8 -1 -2 -3 -0 -10 -17 7 6 5"/>
    
    <!-- Route从edge 4开始 -->
    <route id="route_from_4" edges="4 -8 -1 -2 -3 -0 -10 -17 7 6 5 4"/>
    
    <!-- Route从edge -0开始 -->
    <route id="route_from_-0" edges="-0 -10 -17 7 6 5 4 -8 -1 -2 -3 -0"/>
    
