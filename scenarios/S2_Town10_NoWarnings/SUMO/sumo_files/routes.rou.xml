    <vehicle id="ego_vehicle" type="car" route="ego_route" depart="0" departLane="best" departPos="base" departSpeed="0"/>
    
    <!-- 4辆车 -->
    <vehicle id="car_1" type="car" route="route_from_7" depart="0" departLane="best" departPos="base" departSpeed="10"/>
    <vehicle id="car_2" type="car" route="route_from_5" depart="2" departLane="best" departPos="base" departSpeed="10"/>
